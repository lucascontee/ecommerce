    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>E_Commerce</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ECommerce.Api\**" />
    <Compile Remove="ECommerce.Application\**" />
    <Compile Remove="ECommerce.Domain\**" />
